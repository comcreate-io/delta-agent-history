{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/comcreate-io/delta-agent-history/blob/main/schemas/event.schema.json",
  "title": "Delta Agent History ingress v1",
  "description": "Visible-message ingress. Runtime additionally enforces UTF-8 byte limits, control-character restrictions, exact repository/source authorization, immutable replay and ordering.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "session.open"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "source_instance": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "const": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+]00:00)$"
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "schema_version",
        "type",
        "source",
        "source_instance",
        "session_id",
        "event_id",
        "sequence",
        "created_at",
        "project"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "message.completed"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "source_instance": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+]00:00)$"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "plan"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "schema_version",
        "type",
        "source",
        "source_instance",
        "session_id",
        "event_id",
        "sequence",
        "created_at",
        "role",
        "text"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "session.close"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "source_instance": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+]00:00)$"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        }
      },
      "required": [
        "schema_version",
        "type",
        "source",
        "source_instance",
        "session_id",
        "event_id",
        "sequence",
        "created_at",
        "status"
      ]
    }
  ]
}
