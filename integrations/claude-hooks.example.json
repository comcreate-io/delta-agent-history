{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/delta-history",
            "args": [
              "hook",
              "claude",
              "--instance",
              "workstation"
            ],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/delta-history",
            "args": [
              "hook",
              "claude",
              "--instance",
              "workstation"
            ],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/delta-history",
            "args": [
              "hook",
              "claude",
              "--instance",
              "workstation"
            ],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
